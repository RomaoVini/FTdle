{
  "name": "ftdle-server",
  "version": "1.0.0",
  "description": "Backend do FTdle",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.cjs",
    "build": "tsup src/server.ts",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "dotenv -e .env.test -- vitest run --config ./tests/vitest.config.ts",
    "test:e2e:watch": "dotenv -e .env.test -- vitest --config ./tests/vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "11.0.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "unplugin-swc": "1.5.11",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "^4.1.10"
  }
